        "        sorted_popularity.query('year >= @year_1 and year <= @year_2',inplace = True)\n",
        "    z = list()\n",
        "    counter = 0\n",
        "    for i in sorted_popularity['genres'] :\n",
        "        i = json.loads(i)\n",
        "        for dic in i :\n",
        "            dict(dic)\n",
