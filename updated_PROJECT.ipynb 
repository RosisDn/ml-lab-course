        "    return 0\n",
        "\n",
        "df_ML['is_successful'] = df_ML['profit'].apply(is_successful)\n",
        "success_rate = sum(df_ML['is_successful'] == 1) / len(df_ML) * 100\n",
        "print(f\"Success rate is {success_rate:.2f}%\")"
